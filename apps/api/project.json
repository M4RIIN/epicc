{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["layer:api"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/api --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/api/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run apps/api"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "node tools/build-api.mjs"
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/build-api.mjs"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts"
      }
    }
  }
}
