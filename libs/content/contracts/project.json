{
  "name": "content-contracts",
  "projectType": "library",
  "sourceRoot": "libs/content/contracts/src",
  "tags": ["layer:contracts"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/content/contracts --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/content/contracts/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run libs/content/contracts"
      }
    }
  }
}
